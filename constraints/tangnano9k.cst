// Board-level constraints for the Tang Nano 9K.
// This file describes "what the board has", not "what this design uses".
//
// Sources verified 2026-10-18:
//   - Sipeed official example, 9K_LED_project.cst
//     https://github.com/sipeed/TangNano-9K-example/blob/main/led/src/9K_LED_project.cst
//   - Apicula (device database used by the open-source toolchain), examples/tangnano9k.cst
//     https://github.com/YosysHQ/apicula/blob/master/examples/tangnano9k.cst
//   - Lushay Labs UART example, tangnano9k.cst (UART pins)
//     https://github.com/lushaylabs/tangnano9k-series-examples/blob/master/uart/tangnano9k.cst
//
// nextpnr ignores ports that appear in the constraints but not in the design, so this file can be
// reused wholesale without each project deleting lines.
// (Verified 2026-10-18: extra btn / uart entries still allow place and route to complete.)

// ---- Clock: 27 MHz on-board oscillator ----
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- 6 LEDs: active low ----
// IO_TYPE=LVCMOS18 follows Apicula; the Sipeed official example omits IO_TYPE.
// Both were tried and both pass nextpnr. Apicula is followed here because it states the level explicitly.
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;

// ---- 2 user buttons: active low when pressed, internal pull-up ----
IO_LOC  "btn[0]" 4;
IO_PORT "btn[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "btn[1]" 3;
IO_PORT "btn[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// ---- USB-UART through the on-board BL702 debugger ----
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
